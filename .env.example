# Copy this file to .env and fill in your own keys. Never commit the real .env.
# All values below are placeholders, not real keys.

# --- tools/llm_router.py: free-tier LLM fallback chain ---
OPENROUTER_API_KEY=your-openrouter-key-here
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
GEMINI_API_KEY_2=your-second-gemini-key-here

# Referrer header some OpenRouter free models require. Point this at your own repo/site.
OPENROUTER_REFERRER=https://github.com/Aeripsen/agent-gates

# --- tools/engine/adapters/brave.py: web discovery stage ---
BRAVE_API_KEY=your-brave-search-key-here

# --- tools/engine/alert.py: optional Telegram notification sink ---
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
# Optional second bot for a separate alert channel; falls back to the main bot if unset.
TELEGRAM_GETUPDATES_BOT_TOKEN=
TELEGRAM_GETUPDATES_CHAT_ID=
# Optional tag prefixed to every alert, e.g. "[dev]", useful when running two instances.
ALERT_TAG=

# --- projects/job-search: eligibility_gate.py ---
# The year the example applicant expects to graduate / become available full-time.
GRAD_YEAR=2027
